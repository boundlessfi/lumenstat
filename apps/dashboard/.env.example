# Umami: identity (users, teams) and website analytics. Called server-side only.
UMAMI_URL=http://localhost:3000
# Writer: API metrics. The dashboard holds an operator key and filters by project
# on the server, so viewers only ever see their own project's API data.
WRITER_URL=http://localhost:8090
WRITER_API_KEY=
# Health checks shown to operators.
COLLECTOR_HEALTH_URL=http://localhost:13133
# Public addresses shown in setup snippets.
PUBLIC_UMAMI_URL=http://localhost:3000
PUBLIC_COLLECTOR_URL=http://localhost:4318
# Pinned tracker release shown in snippets (packages/tracker/releases).
TRACKER_VERSION=1.0.0
# Self-service sign-up at /signup: open | approval | closed.
ENROLLMENT_MODE=open
ENROLLMENT_DAILY_LIMIT=25
# Enrollment creates accounts, teams and websites with Umami's admin account.
UMAMI_ADMIN_PASSWORD=
# Local only: accept "localhost" as a domain on the sign-up form.
ENROLLMENT_ALLOW_LOCAL=
