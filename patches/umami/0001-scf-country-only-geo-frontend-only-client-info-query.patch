--- /dev/null
+++ b/src/lib/scf/privacy.ts
@@ -0,0 +1,46 @@
+import ipaddr from 'ipaddr.js';
+
+/**
+ * SCF Analytics privacy switches. Each one is off unless its env var is set, so
+ * this fork behaves exactly like upstream Umami when none are configured.
+ */
+export const scf = {
+  /** Store country only. IPs are cut to /24 or /48 before the geo lookup. */
+  countryOnly: () => !!process.env.SCF_COUNTRY_ONLY,
+  /** Ignore caller-supplied ip, userAgent, browser, os and device on /api/send. */
+  frontendOnly: () => !!process.env.SCF_FRONTEND_ONLY,
+  /** Drop query strings except utm_* parameters, and drop ad click ids. */
+  stripQuery: () => !!process.env.SCF_STRIP_QUERY,
+};
+
+/** Cuts an IP to its network part: /24 for IPv4, /48 for IPv6. */
+export function truncateIp(ip: string | undefined | null): string | undefined {
+  if (!ip) return undefined;
+
+  let clean = ip.trim();
+  if (clean.startsWith('[')) clean = clean.slice(1, clean.indexOf(']') === -1 ? undefined : clean.indexOf(']'));
+  if (/^\d+\.\d+\.\d+\.\d+:\d+$/.test(clean)) clean = clean.slice(0, clean.lastIndexOf(':'));
+  if (!ipaddr.isValid(clean)) return undefined;
+
+  // Turns IPv4-mapped IPv6 (::ffff:1.2.3.4) back into IPv4.
+  const addr = ipaddr.process(clean);
+
+  if (addr.kind() === 'ipv4') {
+    const octets = (addr as ipaddr.IPv4).octets.slice();
+    octets[3] = 0;
+    return octets.join('.');
+  }
+
+  const parts = (addr as ipaddr.IPv6).parts.slice();
+  for (let i = 3; i < 8; i++) parts[i] = 0;
+  return new ipaddr.IPv6(parts).toString();
+}
+
+/** Keeps utm_* parameters only. Everything else in a query string can carry tokens or ids. */
+export function keepUtmOnly(params: URLSearchParams): string {
+  const kept = new URLSearchParams();
+  for (const [key, value] of params) {
+    if (key.toLowerCase().startsWith('utm_')) kept.append(key, value);
+  }
+  return kept.toString();
+}
