+import { afterEach, describe, expect, test, vi } from 'vitest';
+import { getClientInfo } from '@/lib/detect';
+import { keepUtmOnly, truncateIp } from './privacy';
+
+describe('truncateIp', () => {
+  test('cuts IPv4 to /24', () => {
+    expect(truncateIp('203.0.113.77')).toBe('203.0.113.0');
+    expect(truncateIp('203.0.113.77:51234')).toBe('203.0.113.0');
+  });
+
+  test('cuts IPv6 to /48', () => {
+    expect(truncateIp('2001:db8:abcd:12:34:56:78:9a')).toBe('2001:db8:abcd::');
+    expect(truncateIp('[2001:db8:abcd:12::1]')).toBe('2001:db8:abcd::');
+  });
+
+  test('turns IPv4-mapped IPv6 into a cut IPv4', () => {
+    expect(truncateIp('::ffff:198.51.100.9')).toBe('198.51.100.0');
+  });
+
+  test('rejects junk', () => {
+    expect(truncateIp('')).toBeUndefined();
+    expect(truncateIp('not-an-ip')).toBeUndefined();
+    expect(truncateIp(null)).toBeUndefined();
+  });
+});
+
+describe('keepUtmOnly', () => {
+  test('keeps utm_* and drops everything else', () => {
+    const params = new URLSearchParams('utm_source=x&token=secret&utm_campaign=launch&gclid=abc');
+    expect(keepUtmOnly(params)).toBe('utm_source=x&utm_campaign=launch');
+  });
+});
+
+describe('getClientInfo with SCF flags', () => {
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  const request = () =>
+    new Request('https://analytics.example/api/send', {
+      headers: {
+        'user-agent': 'Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 Safari/605.1.15',
+        'x-forwarded-for': '127.0.0.1',
+      },
+    });
+
+  test('ignores caller-supplied ip and user agent when SCF_FRONTEND_ONLY is set', async () => {
+    vi.stubEnv('SCF_FRONTEND_ONLY', '1');
+    const info = await getClientInfo(request(), { ip: '8.8.8.8', userAgent: 'spoofed-agent', screen: '1440x900' });
+    expect(info.ip).not.toBe('8.8.8.8');
+    expect(info.userAgent).not.toBe('spoofed-agent');
+  });
+
+  test('upstream behavior is unchanged without the flag', async () => {
+    const info = await getClientInfo(request(), { userAgent: 'server-side-agent' });
+    expect(info.userAgent).toBe('server-side-agent');
+  });
+
+  test('never returns region or city when SCF_COUNTRY_ONLY is set', async () => {
+    vi.stubEnv('SCF_COUNTRY_ONLY', '1');
+    const info = await getClientInfo(request(), {});
+    expect(info.region).toBeUndefined();
+    expect(info.city).toBeUndefined();
+  });
+});
