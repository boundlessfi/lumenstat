new file mode 100644
index 0000000..642b660
--- /dev/null
+++ b/src/lib/scf/quality.ts
@@ -0,0 +1,130 @@
+import { EVENT_TYPE } from '@/lib/constants';
+import { uuid } from '@/lib/crypto';
+import prisma from '@/lib/prisma';
+import { isDatacenterCheckEnabled, isDatacenterIp } from './datacenter';
+import { isNetworkOverLimit, maxVisitorsPerNetwork } from './fingerprints';
+import { checkBrowserOrigin, isOriginCheckEnabled } from './origin';
+import { POW_HEADER, powBits, verifyProof } from './pow';
+
+/**
+ * SCF: the quality flag. Events that fail any check below are stored in
+ * scf_flagged_event instead of website_event, so Umami's reports never count
+ * them, while operators can still see who is being inflated and how.
+ *
+ *   1. Real browser:   Origin matches the site's domains, Fetch Metadata present.
+ *   2. Proof of JS:    the tracker's proof-of-work header is valid.
+ *   3. Data center:    the IP is not in a published cloud provider range.
+ *   4. Many visitors:  the visitor's network is under the hourly limit.
+ *
+ * Each layer has its own switch, so the fork behaves like upstream when none is set.
+ */
+
+export type FlagReason =
+  | 'missing_origin'
+  | 'not_browser_fetch'
+  | 'no_site_domain'
+  | 'origin_mismatch'
+  | 'no_proof'
+  | 'bad_proof'
+  | 'datacenter_ip'
+  | 'many_visitors_per_network';
+
+export function isQualityCheckEnabled(): boolean {
+  return isOriginCheckEnabled() || powBits() > 0 || isDatacenterCheckEnabled() || maxVisitorsPerNetwork() > 0;
+}
+
+export interface EventToAssess {
+  headers: Headers;
+  websiteId: string;
+  siteDomain: string | null | undefined;
+  url: string;
+  ip: string | undefined;
+  userAgent: string | undefined;
+  createdAt: Date;
+}
+
+export async function assessEvent(event: EventToAssess): Promise<FlagReason[]> {
+  const reasons: FlagReason[] = [];
+
+  if (isOriginCheckEnabled()) {
+    const verdict = checkBrowserOrigin(event.headers, event.siteDomain);
+    if (verdict.ok === false) reasons.push(verdict.reason);
+  }
+
+  const bits = powBits();
+  if (bits > 0) {
+    const verdict = verifyProof(event.headers.get(POW_HEADER), event.websiteId, event.url, bits);
+    if (verdict.ok === false) reasons.push(verdict.reason);
+  }
+
+  if (isDatacenterCheckEnabled() && isDatacenterIp(event.ip)) {
+    reasons.push('datacenter_ip');
+  }
+
+  // Only count visitors that passed everything else, so blocked scripts do not
+  // push real visitors from the same network over the limit.
+  if (reasons.length === 0 && (await isNetworkOverLimit(event.websiteId, event.ip, event.userAgent, event.createdAt))) {
+    reasons.push('many_visitors_per_network');
+  }
+
+  return reasons;
+}
+
+export interface FlaggedEvent {
+  websiteId: string;
+  reasons: FlagReason[];
+  url: string | undefined;
+  hostname: string | undefined;
+  referrer: string | undefined;
+  eventName: string | undefined;
+  country: string | undefined;
+  browser: string | undefined;
+  os: string | undefined;
+  device: string | undefined;
+}
+
+function pathOf(url: string | undefined, hostname: string | undefined): string | undefined {
+  if (!url) return undefined;
+  try {
+    return new URL(url, `https://${hostname || 'localhost'}`).pathname.slice(0, 500);
+  } catch {
+    return undefined;
+  }
+}
+
+function domainOf(referrer: string | undefined): string | undefined {
+  if (!referrer) return undefined;
+  try {
+    return new URL(referrer).hostname.replace(/^www\./, '').slice(0, 500) || undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** Stores a flagged event: path, referrer domain and coarse client info only, never the IP or query. */
+export async function saveFlaggedEvent(event: FlaggedEvent): Promise<void> {
+  // eslint-disable-next-line no-console
+  console.warn(JSON.stringify({ scf: 'event_flagged', websiteId: event.websiteId, reasons: event.reasons }));
+
+  try {
+    await prisma.client.scfFlaggedEvent.create({
+      data: {
+        id: uuid(),
+        websiteId: event.websiteId,
+        reasons: event.reasons,
+        eventType: event.eventName ? EVENT_TYPE.customEvent : EVENT_TYPE.pageView,
+        eventName: event.eventName?.slice(0, 50),
+        hostname: event.hostname?.slice(0, 100),
+        urlPath: pathOf(event.url, event.hostname),
+        referrerDomain: domainOf(event.referrer),
+        country: event.country?.slice(0, 2),
+        browser: event.browser?.slice(0, 20),
+        os: event.os?.slice(0, 20),
+        device: event.device?.slice(0, 20),
+      },
+    });
+  } catch (err) {
+    // eslint-disable-next-line no-console
+    console.error(JSON.stringify({ scf: 'flagged_event_not_saved', error: String(err) }));
+  }
+}
