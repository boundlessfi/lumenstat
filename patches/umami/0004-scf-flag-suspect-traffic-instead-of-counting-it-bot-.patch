+-- SCF: events that failed the bot and inflation checks. Kept apart from
+-- website_event so Umami's own reports never count them. No IP, no query string.
+CREATE TABLE "scf_flagged_event" (
+  "event_id" UUID NOT NULL PRIMARY KEY,
+  "website_id" UUID NOT NULL,
+  "created_at" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "reasons" VARCHAR(30)[],
+  "event_type" INTEGER NOT NULL DEFAULT 1,
+  "event_name" VARCHAR(50),
+  "hostname" VARCHAR(100),
+  "url_path" VARCHAR(500),
+  "referrer_domain" VARCHAR(500),
+  "country" CHAR(2),
+  "browser" VARCHAR(20),
+  "os" VARCHAR(20),
+  "device" VARCHAR(20)
+);
+
+CREATE INDEX "scf_flagged_event_website_id_created_at_idx" ON "scf_flagged_event"("website_id", "created_at");
