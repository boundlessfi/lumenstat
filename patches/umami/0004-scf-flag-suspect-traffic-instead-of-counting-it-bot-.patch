+import { createHash } from 'node:crypto';
+import { describe, expect, it } from 'vitest';
+import { prove, sha256Words } from '@/tracker/pow';
+import { leadingZeroBits, SLOT_MS, verifyProof } from './pow';
+
+const site = '3f1c2c4e-4b1e-4b8f-9c55-7b2f2a7f0a11';
+
+function nodeWords(message: string): number[] {
+  const digest = createHash('sha256').update(message).digest();
+  return Array.from({ length: 8 }, (_, i) => digest.readUInt32BE(i * 4));
+}
+
+describe('tracker sha256', () => {
+  it('matches node:crypto for empty, short, block-boundary, long and non-ASCII input', () => {
+    const inputs = ['', 'abc', 'a'.repeat(55), 'a'.repeat(56), 'a'.repeat(64), 'x'.repeat(1000), 'héllo ✨ /ναι?q=1'];
+    for (const input of inputs) expect(sha256Words(input)).toEqual(nodeWords(input));
+  });
+});
+
+describe('leadingZeroBits', () => {
+  it('counts across bytes', () => {
+    expect(leadingZeroBits(Uint8Array.from([0, 0, 0x10, 0xff]))).toBe(19);
+    expect(leadingZeroBits(Uint8Array.from([0x80]))).toBe(0);
+    expect(leadingZeroBits(Uint8Array.from([0, 0]))).toBe(16);
+  });
+});
+
+describe('proof of JavaScript', () => {
+  const now = Date.UTC(2026, 10, 13, 12, 0, 0);
+  const url = 'https://example.org/docs?utm_source=x';
+
+  it('accepts a proof made by the tracker', () => {
+    const proof = prove(site, url, now, 10);
+    expect(verifyProof(proof, site, url, 10, now)).toEqual({ ok: true });
+  });
+
+  it('accepts the next window for clock skew, rejects windows further away', () => {
+    const proof = prove(site, url, now, 10);
+    expect(verifyProof(proof, site, url, 10, now + SLOT_MS)).toEqual({ ok: true });
+    expect(verifyProof(proof, site, url, 10, now + 2 * SLOT_MS)).toEqual({ ok: false, reason: 'bad_proof' });
+  });
+
+  it('rejects a proof for another page or site, a missing header and junk', () => {
+    const proof = prove(site, url, now, 10);
+    expect(verifyProof(proof, site, `${url}&x=1`, 10, now).ok).toBe(false);
+    expect(verifyProof(proof, '00000000-0000-0000-0000-000000000000', url, 10, now).ok).toBe(false);
+    expect(verifyProof(null, site, url, 10, now)).toEqual({ ok: false, reason: 'no_proof' });
+    expect(verifyProof('1.2.3', site, url, 10, now)).toEqual({ ok: false, reason: 'bad_proof' });
+  });
+
+  it('rejects a nonce that does not reach the required bits', () => {
+    const slot = Math.floor(now / SLOT_MS);
+    let nonce = 0;
+    while (Math.clz32(sha256Words(`${site}:${slot}:${url}:${nonce}`)[0]) >= 10) nonce++;
+    expect(verifyProof(`${slot}.${nonce}`, site, url, 10, now)).toEqual({ ok: false, reason: 'bad_proof' });
+  });
+});
