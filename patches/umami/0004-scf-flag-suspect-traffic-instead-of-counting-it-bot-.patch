@@ -0,0 +1,83 @@
+import { z } from 'zod';
+import prisma from '@/lib/prisma';
+import { parseRequest } from '@/lib/request';
+import { json, unauthorized } from '@/lib/response';
+import { unixTimestampParam } from '@/lib/schema';
+
+/**
+ * SCF: flagged traffic for operators (admins only). Without websiteId it returns
+ * per-site totals and counts per reason; with websiteId it also returns the
+ * latest flagged events for that site. Times are unix seconds.
+ */
+export async function GET(request: Request) {
+  const schema = z.object({
+    startAt: unixTimestampParam,
+    endAt: unixTimestampParam,
+    websiteId: z.uuid().optional(),
+  });
+
+  const { auth, query, error } = await parseRequest(request, schema);
+
+  if (error) {
+    return error();
+  }
+
+  if (!auth?.user?.isAdmin) {
+    return unauthorized();
+  }
+
+  const params = {
+    startDate: new Date(query.startAt * 1000),
+    endDate: new Date(query.endAt * 1000),
+    websiteId: query.websiteId ?? null,
+  };
+
+  const totals: { website_id: string; events: bigint }[] = await prisma.rawQuery(
+    `select website_id, count(*) as events
+       from scf_flagged_event
+      where created_at between {{startDate}} and {{endDate}}
+        and ({{websiteId::uuid}} is null or website_id = {{websiteId::uuid}})
+      group by website_id`,
+    params,
+  );
+
+  const byReason: { website_id: string; reason: string; events: bigint }[] = await prisma.rawQuery(
+    `select website_id, reason, count(*) as events
+       from scf_flagged_event, unnest(reasons) as reason
+      where created_at between {{startDate}} and {{endDate}}
+        and ({{websiteId::uuid}} is null or website_id = {{websiteId::uuid}})
+      group by website_id, reason`,
+    params,
+  );
+
+  const websites = totals.map(row => ({
+    websiteId: row.website_id,
+    events: Number(row.events),
+    reasons: Object.fromEntries(
+      byReason.filter(r => r.website_id === row.website_id).map(r => [r.reason, Number(r.events)]),
+    ),
+  }));
+
+  const recent = query.websiteId
+    ? await prisma.client.scfFlaggedEvent.findMany({
+        where: { websiteId: query.websiteId, createdAt: { gte: params.startDate, lte: params.endDate } },
+        orderBy: { createdAt: 'desc' },
+        take: 50,
+        select: {
+          createdAt: true,
+          reasons: true,
+          eventType: true,
+          eventName: true,
+          hostname: true,
+          urlPath: true,
+          referrerDomain: true,
+          country: true,
+          browser: true,
+          os: true,
+          device: true,
+        },
+      })
+    : undefined;
+
+  return json({ websites, recent });
+}
