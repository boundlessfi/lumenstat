+import { describe, expect, it } from 'vitest';
+import { isInRanges, parseRanges } from './datacenter';
+
+const ranges = parseRanges(`
+# provider: example
+3.0.0.0/15
+3.2.0.0/16        # adjacent, merges with the line above
+13.32.0.0/15
+203.0.113.7/32
+not a cidr
+2600:1f00::/24
+2a01:4f8::/32
+`);
+
+describe('data-center ranges', () => {
+  it('merges adjacent IPv4 ranges', () => {
+    expect(ranges.v4.length / 2).toBe(3);
+  });
+
+  it('matches IPv4 inside, at the edges and outside', () => {
+    expect(isInRanges(ranges, '3.0.0.0')).toBe(true);
+    expect(isInRanges(ranges, '3.2.255.255')).toBe(true);
+    expect(isInRanges(ranges, '3.3.0.0')).toBe(false);
+    expect(isInRanges(ranges, '13.33.10.1')).toBe(true);
+    expect(isInRanges(ranges, '203.0.113.7')).toBe(true);
+    expect(isInRanges(ranges, '203.0.113.8')).toBe(false);
+    expect(isInRanges(ranges, '102.89.1.1')).toBe(false);
+  });
+
+  it('matches IPv6 and IPv4-mapped IPv6', () => {
+    expect(isInRanges(ranges, '2600:1f00:1234::1')).toBe(true);
+    expect(isInRanges(ranges, '2a01:4f8:c0c:1::2')).toBe(true);
+    expect(isInRanges(ranges, '2a01:4f9::1')).toBe(false);
+    expect(isInRanges(ranges, '::ffff:3.1.2.3')).toBe(true);
+  });
+
+  it('ignores empty and invalid input', () => {
+    expect(isInRanges(ranges, '')).toBe(false);
+    expect(isInRanges(ranges, 'nope')).toBe(false);
+    expect(isInRanges(ranges, undefined)).toBe(false);
+  });
+});
diff --git a/src/lib/scf/datacenter.ts b/src/lib/scf/datacenter.ts
new file mode 100644
index 0000000..ef1a861
--- /dev/null
+++ b/src/lib/scf/datacenter.ts
@@ -0,0 +1,129 @@
+import { readFileSync } from 'node:fs';
+import ipaddr from 'ipaddr.js';
+
+/**
+ * SCF: flags events from published cloud and hosting provider IP ranges. Real
+ * visitors browse from homes, offices and phones; scripted traffic usually runs
+ * on rented servers.
+ *
+ * SCF_DATACENTER_RANGES points to a file with one CIDR per line (# for comments),
+ * built by scripts/update-datacenter-ranges.mjs from the providers' own lists.
+ * The IP is only checked in memory; it is never stored.
+ */
+
+type Ranges = { v4: Uint32Array; v6: bigint[] };
+
+let cached: { path: string; ranges: Ranges } | null = null;
+
+function v6ToBigInt(addr: ipaddr.IPv6): bigint {
+  return addr.parts.reduce((acc, part) => (acc << 16n) | BigInt(part), 0n);
+}
+
+function merge<T extends number | bigint>(pairs: [T, T][]): [T, T][] {
+  pairs.sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0));
+  const out: [T, T][] = [];
+  for (const [start, end] of pairs) {
+    const last = out[out.length - 1];
+    if (last && start <= (typeof last[1] === 'bigint' ? (last[1] as bigint) + 1n : (last[1] as number) + 1)) {
+      if (end > last[1]) last[1] = end;
+    } else {
+      out.push([start, end]);
+    }
+  }
+  return out;
+}
+
+/** Parses CIDR lines into merged, sorted [start, end] ranges. Bad lines are skipped. */
+export function parseRanges(text: string): Ranges {
+  const v4: [number, number][] = [];
+  const v6: [bigint, bigint][] = [];
+
+  for (const raw of text.split('\n')) {
+    const line = raw.replace(/#.*/, '').trim();
+    if (!line) continue;
+
+    let parsed: [ipaddr.IPv4 | ipaddr.IPv6, number];
+    try {
+      parsed = ipaddr.parseCIDR(line);
+    } catch {
+      continue;
+    }
+    const [addr, prefix] = parsed;
+
+    if (addr.kind() === 'ipv4') {
+      const start = (addr as ipaddr.IPv4).octets.reduce((acc, o) => acc * 256 + o, 0);
+      const size = 2 ** (32 - prefix);
+      const base = start - (start % size);
+      v4.push([base, base + size - 1]);
+    } else {
+      const value = v6ToBigInt(addr as ipaddr.IPv6);
+      const hostBits = BigInt(128 - prefix);
+      const base = (value >> hostBits) << hostBits;
+      v6.push([base, base + (1n << hostBits) - 1n]);
+    }
+  }
+
+  const mergedV4 = merge(v4);
+  const flat = new Uint32Array(mergedV4.length * 2);
+  mergedV4.forEach(([s, e], i) => {
+    flat[i * 2] = s;
+    flat[i * 2 + 1] = e;
+  });
+
+  return { v4: flat, v6: merge(v6).flat() };
+}
+
+function inSorted<T extends number | bigint>(list: ArrayLike<T>, value: T): boolean {
+  let lo = 0;
+  let hi = list.length / 2 - 1;
+  while (lo <= hi) {
+    const mid = (lo + hi) >> 1;
+    const start = list[mid * 2];
+    const end = list[mid * 2 + 1];
+    if (value < start) hi = mid - 1;
+    else if (value > end) lo = mid + 1;
+    else return true;
+  }
+  return false;
+}
+
+export function isInRanges(ranges: Ranges, ip: string | undefined | null): boolean {
+  if (!ip || !ipaddr.isValid(ip)) return false;
+  const addr = ipaddr.process(ip);
+
+  if (addr.kind() === 'ipv4') {
+    const value = (addr as ipaddr.IPv4).octets.reduce((acc, o) => acc * 256 + o, 0);
+    return inSorted(ranges.v4, value);
+  }
+  return inSorted(ranges.v6, v6ToBigInt(addr as ipaddr.IPv6));
+}
+
+function load(): Ranges | null {
+  const path = process.env.SCF_DATACENTER_RANGES;
+  if (!path) return null;
+  if (cached?.path === path) return cached.ranges;
+
+  try {
+    const ranges = parseRanges(readFileSync(path, 'utf8'));
+    cached = { path, ranges };
+    // eslint-disable-next-line no-console
+    console.info(
+      JSON.stringify({ scf: 'datacenter_ranges_loaded', v4: ranges.v4.length / 2, v6: ranges.v6.length / 2 }),
+    );
+    return ranges;
+  } catch (err) {
+    // eslint-disable-next-line no-console
+    console.error(JSON.stringify({ scf: 'datacenter_ranges_unreadable', path, error: String(err) }));
+    cached = { path, ranges: { v4: new Uint32Array(0), v6: [] } };
+    return cached.ranges;
+  }
+}
+
+export function isDatacenterCheckEnabled(): boolean {
+  return !!process.env.SCF_DATACENTER_RANGES;
+}
+
+export function isDatacenterIp(ip: string | undefined | null): boolean {
+  const ranges = load();
+  return ranges ? isInRanges(ranges, ip) : false;
+}
diff --git a/src/lib/scf/fingerprints.ts b/src/lib/scf/fingerprints.ts
new file mode 100644
index 0000000..bc72cc1
--- /dev/null
+++ b/src/lib/scf/fingerprints.ts
@@ -0,0 +1,58 @@
+import { createHmac } from 'node:crypto';
+import { secret } from '@/lib/crypto';
+import redis from '@/lib/redis';
+import { getDailySalt } from './daily-salt';
+import { truncateIp } from './privacy';
+
+/**
+ * SCF: many visitors from one network. Counts distinct visitors (IP + user agent)
+ * per site, per /24 (IPv4) or /48 (IPv6) network, per hour, in Redis with a
+ * HyperLogLog. Once a network passes the limit, NEW visitors from it are flagged;
+ * visitors already counted this hour keep counting.
+ *
+ * Keys and members are HMACs under the random daily salt, so Redis never holds
+ * an IP or a network address, and they expire after two hours.
+ */
+
+const HOUR_MS = 3600 * 1000;
+const KEY_TTL_SECONDS = 2 * 3600;
+
+/** Distinct visitors allowed per network, site and hour, or 0 when the check is off. */
+export function maxVisitorsPerNetwork(): number {
+  const value = Number(process.env.SCF_MAX_VISITORS_PER_IP_HOUR || 0);
+  return Number.isInteger(value) && value > 0 ? value : 0;
+}
+
+function mac(key: string, value: string): string {
+  return createHmac('sha256', key).update(value).digest('base64url').slice(0, 22);
+}
+
+/** Records the visitor and returns true when it is new and its network is over the limit. */
+export async function isNetworkOverLimit(
+  websiteId: string,
+  ip: string | undefined,
+  userAgent: string | undefined,
+  now = new Date(),
+): Promise<boolean> {
+  const limit = maxVisitorsPerNetwork();
+  const network = truncateIp(ip);
+  if (!limit || !network || !redis.enabled) return false;
+
+  try {
+    const salt = (await getDailySalt(now)) ?? secret();
+    const hour = Math.floor(now.getTime() / HOUR_MS);
+    const key = `scf:net:${websiteId}:${hour}:${mac(salt, network)}`;
+    const member = mac(salt, `${ip}|${userAgent ?? ''}`);
+
+    await redis.client.connect();
+    const client = redis.client.client;
+    const added = await client.pfAdd(key, member);
+    if (!added) return false;
+
+    const [count] = await Promise.all([client.pfCount(key), client.expire(key, KEY_TTL_SECONDS)]);
+    return Number(count) > limit;
+  } catch {
+    // Counting is best-effort; it must never block collection.
+    return false;
+  }
+}
