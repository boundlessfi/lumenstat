new file mode 100644
index 0000000..942dce6
--- /dev/null
+++ b/src/lib/scf/pow.ts
@@ -0,0 +1,60 @@
+import { createHash } from 'node:crypto';
+
+/**
+ * SCF: proof of JavaScript. The tracker searches for a nonce so that
+ * sha256("<website id>:<slot>:<url>:<nonce>") starts with a number of zero bits,
+ * where <slot> is the 10-minute window it ran in. It sends "<slot>.<nonce>" in the
+ * `x-lumenstat-pow` header. One visitor pays a few milliseconds; a script that
+ * fakes thousands of page views must run the tracker's logic for each one.
+ *
+ * This is one layer, not proof of a human. It only raises the cost of faking.
+ */
+
+export const POW_HEADER = 'x-lumenstat-pow';
+export const SLOT_MS = 10 * 60 * 1000;
+
+/** Required zero bits, or 0 when the check is off. The tracker works to 10 bits. */
+export function powBits(): number {
+  const bits = Number(process.env.SCF_POW_BITS || 0);
+  return Number.isInteger(bits) && bits > 0 && bits <= 24 ? bits : 0;
+}
+
+export function leadingZeroBits(digest: Uint8Array): number {
+  let bits = 0;
+  for (const byte of digest) {
+    if (byte === 0) {
+      bits += 8;
+      continue;
+    }
+    return bits + Math.clz32(byte) - 24;
+  }
+  return bits;
+}
+
+export function proofDigest(websiteId: string, slot: number, url: string, nonce: string): Uint8Array {
+  return createHash('sha256').update(`${websiteId}:${slot}:${url}:${nonce}`).digest();
+}
+
+export type ProofVerdict = { ok: true } | { ok: false; reason: 'no_proof' | 'bad_proof' };
+
+/** Checks the header against the payload. Slots one window either side are accepted for clock skew. */
+export function verifyProof(
+  header: string | null,
+  websiteId: string,
+  url: string,
+  bits: number,
+  now = Date.now(),
+): ProofVerdict {
+  if (!header) return { ok: false, reason: 'no_proof' };
+
+  const match = /^(\d{1,10})\.(\d{1,12})$/.exec(header.trim());
+  if (!match) return { ok: false, reason: 'bad_proof' };
+
+  const slot = Number(match[1]);
+  const current = Math.floor(now / SLOT_MS);
+  if (Math.abs(slot - current) > 1) return { ok: false, reason: 'bad_proof' };
+
+  return leadingZeroBits(proofDigest(websiteId, slot, url ?? '', match[2])) >= bits
+    ? { ok: true }
+    : { ok: false, reason: 'bad_proof' };
+}
