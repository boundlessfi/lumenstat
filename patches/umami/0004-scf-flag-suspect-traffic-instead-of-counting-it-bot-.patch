diff --git a/src/tracker/pow.ts b/src/tracker/pow.ts
new file mode 100644
index 0000000..0b9febd
--- /dev/null
+++ b/src/tracker/pow.ts
@@ -0,0 +1,106 @@
+/**
+ * SCF: proof of JavaScript for the tracker (checked by src/lib/scf/pow.ts).
+ *
+ * Finds a nonce so that sha256("<website>:<slot>:<url>:<nonce>") starts with
+ * POW_BITS zero bits, where <slot> is the current 10-minute window. About 1,000
+ * hashes on average: a few milliseconds on a phone. The result is cached per
+ * page and window, so repeat events on a page cost nothing.
+ *
+ * A small synchronous SHA-256 keeps the tracker free of dependencies and avoids
+ * WebCrypto's per-call async overhead.
+ */
+
+export const POW_BITS = 10;
+const SLOT_MS = 10 * 60 * 1000;
+
+const K: number[] = [];
+const H: number[] = [];
+
+// Round constants and initial hash: fractional parts of cube and square roots of the first primes.
+for (let n = 2, i = 0; i < 64; n++) {
+  let prime = true;
+  for (let d = 2; d * d <= n; d++) {
+    if (n % d === 0) {
+      prime = false;
+      break;
+    }
+  }
+  if (prime) {
+    if (i < 8) H[i] = (n ** 0.5 * 2 ** 32) | 0;
+    K[i++] = (n ** (1 / 3) * 2 ** 32) | 0;
+  }
+}
+
+const ror = (x: number, n: number) => (x >>> n) | (x << (32 - n));
+const encoder = new TextEncoder();
+
+/** The full SHA-256 digest as eight 32-bit words. */
+export const sha256Words = (message: string): number[] => {
+  const bytes = encoder.encode(message);
+  const length = bytes.length;
+  const total = ((length + 72) >> 6) << 6;
+  const m = new Uint8Array(total);
+  m.set(bytes);
+  m[length] = 0x80;
+  const bits = length * 8;
+  m[total - 4] = bits >>> 24;
+  m[total - 3] = (bits >>> 16) & 255;
+  m[total - 2] = (bits >>> 8) & 255;
+  m[total - 1] = bits & 255;
+
+  const h = H.slice();
+  const w: number[] = [];
+
+  for (let offset = 0; offset < total; offset += 64) {
+    for (let i = 0; i < 16; i++) {
+      const j = offset + i * 4;
+      w[i] = (m[j] << 24) | (m[j + 1] << 16) | (m[j + 2] << 8) | m[j + 3];
+    }
+    for (let i = 16; i < 64; i++) {
+      const a = w[i - 15];
+      const b = w[i - 2];
+      w[i] =
+        (w[i - 16] + (ror(a, 7) ^ ror(a, 18) ^ (a >>> 3)) + w[i - 7] + (ror(b, 17) ^ ror(b, 19) ^ (b >>> 10))) | 0;
+    }
+
+    let [a, b, c, d, e, f, g, k] = h;
+    for (let i = 0; i < 64; i++) {
+      const t1 = (k + (ror(e, 6) ^ ror(e, 11) ^ ror(e, 25)) + ((e & f) ^ (~e & g)) + K[i] + w[i]) | 0;
+      const t2 = ((ror(a, 2) ^ ror(a, 13) ^ ror(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) | 0;
+      k = g;
+      g = f;
+      f = e;
+      e = (d + t1) | 0;
+      d = c;
+      c = b;
+      b = a;
+      a = (t1 + t2) | 0;
+    }
+
+    h[0] = (h[0] + a) | 0;
+    h[1] = (h[1] + b) | 0;
+    h[2] = (h[2] + c) | 0;
+    h[3] = (h[3] + d) | 0;
+    h[4] = (h[4] + e) | 0;
+    h[5] = (h[5] + f) | 0;
+    h[6] = (h[6] + g) | 0;
+    h[7] = (h[7] + k) | 0;
+  }
+
+  return h.map(x => x >>> 0);
+};
+
+let last: { prefix: string; proof: string } | undefined;
+
+/** Returns "<slot>.<nonce>" for the `x-lumenstat-pow` header. */
+export const prove = (website: string, url: string, now = Date.now(), bits = POW_BITS): string => {
+  const slot = Math.floor(now / SLOT_MS);
+  const prefix = `${website}:${slot}:${url}:`;
+  if (last?.prefix === prefix) return last.proof;
+
+  let nonce = 0;
+  while (Math.clz32(sha256Words(prefix + nonce)[0]) < bits) nonce++;
+
+  last = { prefix, proof: `${slot}.${nonce}` };
+  return last.proof;
+};
