# Local development values. scripts/setup-env.sh writes a .env with random secrets.
POSTGRES_PASSWORD=change-me
UMAMI_APP_SECRET=change-me-to-a-long-random-string
# Shared between the collector and the writer; the writer rejects anything else.
SCF_COLLECTOR_SECRET=change-me-at-least-16-chars
# Optional operator key for the metrics API, for first setup. Issue DB-backed keys after that.
SCF_BOOTSTRAP_OPERATOR_KEY=change-me-at-least-16-chars
# Filled in by scripts/create-api-tenant.sh
TEST_API_INGEST_KEY=
